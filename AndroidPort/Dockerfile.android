# Used by scripts/build_android_docker.py with its filtered, temporary context.
# BuildKit's bundled frontend avoids an extra syntax-image download.
ARG FFTA_TOOLCHAIN=toolchain
ARG FFTA_ANDROID_SDK_SOURCE=sdk-clean
FROM rust:1.100.0-slim-bookworm@sha256:7c7d4eb4d05b7781187a327809466cfddf29753f6defdc3d19a0e291951b7a37 AS rust
FROM eclipse-temurin:25-jdk-noble@sha256:4ddc1a8bdaf283421df5487411aff10b797ccf1e06a339041005114c8f489b5c AS sdk-tools

COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust /usr/local/cargo /usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo \
    ANDROID_HOME=/opt/android-sdk ANDROID_SDK_ROOT=/opt/android-sdk \
    GRADLE_USER_HOME=/root/.gradle
ENV PATH=/usr/local/cargo/bin:/opt/android-sdk/cmdline-tools/latest/bin:$PATH

RUN test "$(dpkg --print-architecture)" = amd64 \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git python3 unzip \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add aarch64-linux-android

# Official Android command-line tools, verified against the SDK repository catalog.
RUN curl --fail --location --retry 3 \
        https://dl.google.com/android/repository/commandlinetools-linux-16111833_latest.zip \
        -o /tmp/android-tools.zip \
    && echo '0877a1d048fe4a24efe2eff536ca4223f7adeb58648bb81909d33c446918cfa8  /tmp/android-tools.zip' | sha256sum --check - \
    && mkdir -p /opt/android-sdk/cmdline-tools /tmp/android-tools \
    && unzip -q /tmp/android-tools.zip -d /tmp/android-tools \
    && mv /tmp/android-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest \
    && rm -rf /tmp/android-tools /tmp/android-tools.zip
# Pin the replacement for the deprecated sdkmanager and disable its metrics.
# The SDK and CLI remain in the cached toolchain image across source builds.
RUN curl --fail --location --retry 3 \
        https://dl.google.com/android/cli/1.1.16919734/linux_x86_64/android-cli \
        -o /usr/local/bin/ffta-android-cli \
    && echo '9803784ddf24d4699929eece519ffa8b066afa9a2b93bd58749b3c6d2caaeeec  /usr/local/bin/ffta-android-cli' | sha256sum --check - \
    && chmod 0755 /usr/local/bin/ffta-android-cli
FROM sdk-tools AS sdk-clean
RUN yes | ffta-android-cli --no-metrics --sdk="$ANDROID_HOME" sdk install \
        platforms/android-37.2 ndk/30.0.16248370 \
        platform-tools build-tools/37.0.0 \
    && test -x "$ANDROID_HOME/platform-tools/adb"
# An explicitly selected existing toolchain can seed a local migration. The
# default builds the same SDK from the pinned CLI when no seed is supplied.
FROM ${FFTA_ANDROID_SDK_SOURCE} AS toolchain
COPY --from=sdk-tools /usr/local/bin/ffta-android-cli /usr/local/bin/ffta-android-cli
RUN test -d "$ANDROID_HOME/platforms/android-37.2" \
    && test -x "$ANDROID_HOME/build-tools/37.0.0/aapt" \
    && test -x "$ANDROID_HOME/ndk/30.0.16248370/toolchains/llvm/prebuilt/linux-x86_64/bin/clang" \
    && test -x "$ANDROID_HOME/platform-tools/adb" \
    && rustc --version

# End of cached toolchain
FROM ${FFTA_TOOLCHAIN} AS native
WORKDIR /workspace
ARG BUILD_SCRIPT=scripts/build_android.py
ARG CACHE_SCOPE=androidport
COPY project/Cargo.toml project/Cargo.lock ./
COPY project/crates/ crates/
COPY project/Licenses/ Licenses/
COPY project/${BUILD_SCRIPT} ${BUILD_SCRIPT}
RUN --mount=type=cache,id=ffta-android-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=ffta-android-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=ffta-android-${CACHE_SCOPE}-target,target=/workspace/target,sharing=locked \
    find crates -type f -exec touch {} + \
    && python3 "$BUILD_SCRIPT" --native-only --sdk "$ANDROID_HOME" --ndk 30.0.16248370

FROM native AS build
COPY project/android/ android/
COPY project/BUILD-SOURCE.json ./
COPY export_android.py /opt/ffta/export_android.py
ARG FFTA_PREVIEW_SIGNING=0
ARG FFTA_PREVIEW_SIGNER_INPUT=none
ARG FFTA_PREVIEW_SIGNING_NONCE=none
# A release preview may use a persistent key supplied only as BuildKit secrets.
# The key hash invalidates this layer when the selected keystore changes.
RUN --mount=type=cache,id=ffta-android-${CACHE_SCOPE}-gradle,target=/root/.gradle,sharing=locked \
    --mount=type=cache,id=ffta-android-${CACHE_SCOPE}-signing,target=/root/.android,sharing=locked \
    --mount=type=secret,id=ffta_preview_keystore \
    --mount=type=secret,id=ffta_preview_password \
    if [ "$FFTA_PREVIEW_SIGNING" = 1 ]; then \
        test "$FFTA_PREVIEW_SIGNING_NONCE" != none \
        && test -n "$FFTA_PREVIEW_SIGNING_NONCE" \
        && test -r /run/secrets/ffta_preview_keystore \
        && test -r /run/secrets/ffta_preview_password \
        && test "$(sha256sum /run/secrets/ffta_preview_keystore | cut -d ' ' -f 1)" = "$FFTA_PREVIEW_SIGNER_INPUT" \
        && export FFTA_PREVIEW_KEYSTORE=/run/secrets/ffta_preview_keystore \
        && export FFTA_PREVIEW_PASSWORD_FILE=/run/secrets/ffta_preview_password; \
    elif [ "$FFTA_PREVIEW_SIGNING" != 0 ]; then exit 1; fi \
    && bash android/gradlew -p android :app:assembleDebug :app:testDebugUnitTest --build-cache --no-daemon --console=plain \
    && if [ "$FFTA_PREVIEW_SIGNING" = 1 ]; then \
        expected="$(keytool -exportcert -keystore /run/secrets/ffta_preview_keystore -alias ffta-preview \
            -storepass:file /run/secrets/ffta_preview_password | sha256sum | cut -d ' ' -f 1)" \
        && report="$("$ANDROID_HOME/build-tools/37.0.0/apksigner" -J-enable-native-access=ALL-UNNAMED verify --print-certs android/app/build/outputs/apk/debug/app-debug.apk)" \
        && printf '%s\n' "$report" | grep -F "Signer #1 certificate SHA-256 digest: $expected"; \
    fi \
    && python3 /opt/ffta/export_android.py android/app/build/outputs/apk/debug/app-debug.apk /artifacts \
    && rm -rf android/app/build android/build android/.gradle android/.kotlin \
    && { rustc --version; cargo --version; java -version 2>&1; \
         printf '\nSDK37.2 / build-tools37.0.0 / NDK30.0.16248370 / ARM64 / API24\n'; \
         cat "$ANDROID_HOME/platform-tools/source.properties"; \
       } >> /artifacts/BUILD-INFO.txt

FROM scratch AS export
COPY --from=build /artifacts/ /
